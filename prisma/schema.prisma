generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: With Prisma 7 + "prisma-client" generator, connection URLs live in
  // prisma.config.ts (for CLI/migrate) and are passed via driver adapter to
  // PrismaClient constructor (see src/lib/prisma.ts and prisma/seed.ts).
  // We still document DATABASE_URL / DIRECT_URL usage in .env.example.
}

enum Role {
  ADMIN
  INSTRUCTOR
  MEMBER
  PROSPECTIVE_INSTRUCTOR
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  phone              String?
  dailyReminderTime  String?             // e.g. "07:30" in 24h format
  role               Role                @default(MEMBER)
  status             String              @default("active")
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  subscriptions      Subscription[]
  enrollments        ProgramEnrollment[]
  performances       ExercisePerformance[]
  workoutLogs        WorkoutLog[]
  smsLogs            SmsLog[]
  bookings           Booking[]
  homeEquipment      UserEquipment[]
}

model SubscriptionTier {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  stripePriceId String?
  monthlyCents  Int?
  subscriptions Subscription[]
}

model Subscription {
  id               String           @id @default(cuid())
  userId           String
  tierId           String
  stripeCustomerId String?
  stripeSubId      String?
  status           String           @default("active")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             SubscriptionTier @relation(fields: [tierId], references: [id])
}

model Exercise {
  id                String                @id @default(cuid())
  name              String
  defaultSetScheme  String?
  defaultSets       Int?
  defaultWeightTier String?
  description       String?
  videoUrl          String?
  tags              String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workoutItems      WorkoutExercise[]
  performances      ExercisePerformance[]
  requiredEquipment ExerciseEquipment[]
}

model Workout {
  id          String            @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  exercises   WorkoutExercise[]
  programDays ProgramDay[]
  dayOptions  ProgramDayOption[]
  logs        WorkoutLog[]
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  exerciseId String
  sortOrder  Int      @default(0)
  setScheme  String?
  repPattern String?
  weightTier String?
  sets       Int?
  reps       String?
  restSec    Int?
  notes      String?
  workout    Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise  @relation(fields: [exerciseId], references: [id])

  @@index([workoutId, sortOrder])
}

model ExercisePerformance {
  id                String   @id @default(cuid())
  userId            String
  exerciseId        String
  workoutExerciseId String?
  setScheme         String
  weightTier        String
  startingWeightLbs Float?
  repsCompleted     Int?     // total reps completed at the logged weight in this session
  setsCompleted     Int?     // number of sets completed
  performedAt       DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise          Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId, performedAt])
}

model WorkoutLog {
  id          String   @id @default(cuid())
  userId      String
  workoutId   String
  performedAt DateTime @default(now())
  completed   Boolean  @default(true)
  progress    Int      @default(100)  // % of exercises marked finished when logged (0-100)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout     Workout  @relation(fields: [workoutId], references: [id])

  @@index([userId, performedAt])
}

model Program {
  id            String              @id @default(cuid())
  slug          String              @unique
  name          String
  description   String?
  tierSlug      String              @default("starter")
  category      String?
  durationWeeks Int                 @default(4)
  sortOrder     Int                 @default(0)
  published     Boolean             @default(true)
  coverUrl      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  weeks         ProgramWeek[]
  enrollments   ProgramEnrollment[]
}

model ProgramWeek {
  id         String       @id @default(cuid())
  programId  String
  weekNumber Int
  program    Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  days       ProgramDay[]

  @@unique([programId, weekNumber])
}

model ProgramDay {
  id        String             @id @default(cuid())
  weekId    String
  dayNumber Int
  workoutId String?            // legacy / default option
  notes     String?
  videoUrl  String?
  week      ProgramWeek        @relation(fields: [weekId], references: [id], onDelete: Cascade)
  workout   Workout?           @relation(fields: [workoutId], references: [id])
  options   ProgramDayOption[]

  @@unique([weekId, dayNumber])
}

model ProgramDayOption {
  id        String     @id @default(cuid())
  dayId     String
  workoutId String
  label     String     // e.g. "Gym", "Home - Bodyweight", "Home - Dumbbells + Bands"
  sortOrder Int        @default(0)
  day       ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  workout   Workout    @relation(fields: [workoutId], references: [id])
}

model ProgramEnrollment {
  id          String   @id @default(cuid())
  userId      String
  programId   String
  startedAt   DateTime @default(now())
  currentWeek Int      @default(1)
  currentDay  Int      @default(1)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model LiveSession {
  id          String   @id @default(cuid())
  title       String
  startsAt    DateTime
  durationMin Int      @default(60)
  meetingUrl  String?
  tierSlug    String   @default("first_class")
  createdAt   DateTime @default(now())
}

model AdminContact {
  id          String   @id @default(cuid())
  email       String
  phone       String?
  calendlyUrl String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model AdminAvailability {
  id              String   @id @default(cuid())
  weekday         Int      // 0=Sunday ... 6=Saturday
  startHour       Int      // 0-23
  startMinute     Int      // 0-59
  endHour         Int
  endMinute       Int
  slotDurationMin Int      @default(15)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  memberEmail   String
  memberPhone   String?
  adminEmail    String
  adminPhone    String?
  scheduledAt   DateTime
  durationMin   Int      @default(15)
  zoomUrl       String?
  status        String   @default("pending") // pending, confirmed, completed, cancelled
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
}

model SmsLog {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  message   String
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Equipment {
  id          String             @id @default(cuid())
  name        String             @unique
  category    String?            // e.g. "bodyweight", "dumbbells", "bands", "bench", "barbell", "pullup", "kettlebell"
  description String?
  createdAt   DateTime           @default(now())
  exercises   ExerciseEquipment[]
  userItems   UserEquipment[]
}

model ExerciseEquipment {
  exerciseId  String
  equipmentId String
  exercise    Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment   Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  @@id([exerciseId, equipmentId])
}

model UserEquipment {
  id          String     @id @default(cuid())
  userId      String
  equipmentId String
  hasAtHome   Boolean    @default(true)
  quantity    Int        @default(1)
  notes       String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment   Equipment  @relation(fields: [equipmentId], references: [id])
  @@unique([userId, equipmentId])
}