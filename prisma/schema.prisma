generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: With Prisma 7 + "prisma-client" generator, connection URLs live in
  // prisma.config.ts (for CLI/migrate) and are passed via driver adapter to
  // PrismaClient constructor (see src/lib/prisma.ts and prisma/seed.ts).
  // We still document DATABASE_URL / DIRECT_URL usage in .env.example.
}

enum Role {
  ADMIN
  INSTRUCTOR
  PLATFORM_ADMIN
  MEMBER
  PROSPECTIVE_INSTRUCTOR
}

/** What happens in one phase of a working set (hold, reps, burnout, timed). */
enum SetPhaseType {
  HOLD
  REPS
  BURNOUT
  TIMED
}

/** How rep count is prescribed when phaseType is REPS (or burnout logging). */
enum RepKind {
  FIXED
  BURNOUT
  MAX
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  phone              String?
  /** Normalized E.164 when known (e.g. +15551234567). Prefer for match/send. */
  phoneE164          String?
  dailyReminderTime  String?             // e.g. "07:30" in 24h format
  /** Explicit SMS marketing/coaching consent timestamp (TCPA / carrier readiness). */
  smsConsentAt       DateTime?
  /** Last carrier/keyword or in-app opt-out. */
  smsOptOutAt        DateTime?
  /** Last re-opt-in (START or settings). Effective opt-out when smsOptOutAt > smsOptInAt. */
  smsOptInAt         DateTime?
  city               String?
  state              String?
  heightCm           Int?
  birthdate          DateTime?
  goals              String?
  role               Role                @default(MEMBER)
  passwordHash       String?
  status             String              @default("active")
  hidden             Boolean             @default(false)
  hiddenAt           DateTime?
  notes              String?
  signupPlan         String?
  registeredAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  memberProfile      MemberProfile?
  oauthIdentities    OAuthIdentity[]
  coachPrefs         MemberCoachPrefs?
  subscriptions      Subscription[]
  enrollments        ProgramEnrollment[]
  performances       ExercisePerformance[]
  workoutLogs        WorkoutLog[]
  smsLogs            SmsLog[]
  bookings           Booking[]
  homeEquipment      UserEquipment[]
  weatherLogs        UserWeatherLog[]
  promptResponses    PromptResponse[]
  measurements       UserMeasurement[]
  analyticsSessions  AnalyticsSession[]
  analyticsEvents    AnalyticsEvent[]
  subscriptionPayments FactSubscriptionPayment[]
  memberDailySnapshots MartMemberDailySnapshot[]
  auditEventsAsActor AuditEvent[]        @relation("AuditActor")
}

model SubscriptionTier {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  stripePriceId String?
  monthlyCents  Int?
  subscriptions Subscription[]
}

model Subscription {
  id               String           @id @default(cuid())
  userId           String
  tierId           String
  stripeCustomerId String?
  stripeSubId      String?
  status           String           @default("active")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             SubscriptionTier @relation(fields: [tierId], references: [id])
}

model Exercise {
  id                String                @id @default(cuid())
  name              String
  defaultSetScheme  String?
  defaultSets       Int?
  defaultWeightTier String?
  description       String?
  videoUrl          String?
  tags              String?
  /// Soft-archive: hidden from pickers / active library; existing workout refs stay intact.
  archivedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workoutItems      WorkoutExercise[]
  performances      ExercisePerformance[]
  requiredEquipment ExerciseEquipment[]

  @@index([archivedAt])
}

model Workout {
  id                String            @id @default(cuid())
  name              String
  description       String?
  certifiedAt       DateTime?
  exportText        String?           @db.Text
  certifiedBy       String?
  /// catalog | template | sms | maintain | …
  source            String            @default("catalog")
  restTimerEnabled  Boolean           @default(false)
  restTimerSeconds  Int?
  /// End-of-rest alert: whistle | bell | buzzer | cybertruck
  restTimerSound    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  exercises         WorkoutExercise[]
  programDays ProgramDay[]
  dayOptions  ProgramDayOption[]
  cycleSlots  WorkoutCycleDaySlot[]
  logs        WorkoutLog[]
  /// Canonical row for coach template library (paste always clones this workout).
  templateMeta      WorkoutTemplate?
}

/// Coach template library entry — paste always deep-clones `workoutId` (never shared by reference).
model WorkoutTemplate {
  id           String    @id @default(cuid())
  name         String
  /// Folder-style organization: adult, athletes, youth, general, …
  category     String    @default("general")
  /// Free-text version tag (e.g. v_adult, vyoungkids).
  versionLabel String?
  notes        String?   @db.Text
  workoutId    String    @unique
  /// Soft-archive: hidden from default library; restore before permanent delete.
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workout      Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([category, name])
  @@index([updatedAt])
  @@index([archivedAt])
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  exerciseId String
  sortOrder  Int      @default(0)
  setScheme  String?
  repPattern String?
  weightTier String?
  /// Legacy flat prescription — migrate to setCount + phases, then deprecate.
  sets       Int?
  reps       String?
  restSec    Int?
  /// Structured prescription: number of working sets (1–10).
  setCount             Int?
  /// Rest between working sets in seconds (e.g. 90 for 1:30).
  restBetweenSetsSec   Int?
  blockName            String?
  notes      String?
  workout    Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise  @relation(fields: [exerciseId], references: [id])
  phases     WorkoutSetPhase[]

  @@index([workoutId, sortOrder])
}

/// Template for what happens inside one working set; repeats for all setCount sets.
model WorkoutSetPhase {
  id                String        @id @default(cuid())
  workoutExerciseId String
  phaseIndex        Int
  phaseType         SetPhaseType
  durationSec       Int?
  reps              Int?
  repKind           RepKind       @default(FIXED)
  positionCue       String?
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, phaseIndex])
  @@index([workoutExerciseId])
}

model ExercisePerformance {
  id                String   @id @default(cuid())
  userId            String
  exerciseId        String
  workoutExerciseId String?
  setScheme         String
  weightTier        String
  startingWeightLbs Float?
  repsCompleted     Int?     // total reps completed at the logged weight in this session
  setsCompleted     Int?     // number of sets completed
  performedAt       DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise          Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId, performedAt])
}

model WorkoutLog {
  id          String   @id @default(cuid())
  userId      String
  workoutId   String
  performedAt DateTime @default(now())
  completed   Boolean  @default(true)
  progress    Int      @default(100)  // % of exercises marked finished when logged (0-100)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout     Workout  @relation(fields: [workoutId], references: [id])

  @@index([userId, performedAt])
}

model Program {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  description        String?
  tierSlug           String              @default("starter")
  category           String?
  durationWeeks      Int                 @default(4)
  phaseDurationWeeks Int                 @default(4)
  totalPhases        Int                 @default(1)
  sortOrder          Int                 @default(0)
  published          Boolean             @default(true)
  coverUrl           String?
  startDate          String?             // YYYY-MM-DD program calendar anchor
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  weeks              ProgramWeek[]
  macroPhases        ProgramMacroPhase[]
  enrollments        ProgramEnrollment[]
  workoutCycles      WorkoutCycle[]
}

/// Reusable 28-day workout cycle — library template or deployed month on a program.
model WorkoutCycle {
  id           String         @id @default(cuid())
  name         String
  description  String?
  /// Set when deployed on a program; null = standalone library template.
  programId    String?
  /// Month slot (M1=1 … M1D28). Null for library-only templates.
  cycleMonth   Int?
  clonedFromId String?
  published    Boolean        @default(false)
  /// Soft-archive: look-back shelf before permanent delete.
  archivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  program      Program?       @relation(fields: [programId], references: [id], onDelete: Cascade)
  clonedFrom   WorkoutCycle?  @relation("WorkoutCycleClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones       WorkoutCycle[] @relation("WorkoutCycleClone")
  days         WorkoutCycleDay[]

  @@unique([programId, cycleMonth])
  @@index([programId])
  @@index([archivedAt])
}

/// One day (1–28) inside a workout cycle.
model WorkoutCycleDay {
  id          String                @id @default(cuid())
  cycleId     String
  dayNumber   Int
  isDayOff    Boolean               @default(false)
  notes       String?
  publishedAt DateTime?
  cycle       WorkoutCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  slots       WorkoutCycleDaySlot[]

  @@unique([cycleId, dayNumber])
}

/// Gym or Home workout slot on a cycle day.
model WorkoutCycleDaySlot {
  id               String         @id @default(cuid())
  cycleDayId       String
  workoutId        String
  trainingLocation String
  sortOrder        Int            @default(0)
  cycleDay         WorkoutCycleDay @relation(fields: [cycleDayId], references: [id], onDelete: Cascade)
  workout          Workout        @relation(fields: [workoutId], references: [id])

  @@unique([cycleDayId, trainingLocation])
  @@index([workoutId])
}

/// Jeremy macro cycle: conditioning → hypertrophy → strength → power (week ranges per phase).
model ProgramMacroPhase {
  id         String  @id @default(cuid())
  programId  String
  phaseIndex Int
  slug       String
  name       String
  minWeeks   Int
  maxWeeks   Int
  sortOrder  Int     @default(0)
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, phaseIndex])
  @@index([programId, sortOrder])
}

model ProgramWeek {
  id              String       @id @default(cuid())
  programId       String
  weekNumber      Int
  /// 1-based macro phase (conditioning=1, hypertrophy=2, strength=3, power=4).
  macroPhaseIndex Int          @default(1)
  /// Week within the macro phase (member enrollment currentWeek maps here).
  phaseWeekNumber Int          @default(1)
  program         Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  days            ProgramDay[]

  @@unique([programId, weekNumber])
  @@index([programId, macroPhaseIndex, phaseWeekNumber])
}

model ProgramDay {
  id             String              @id @default(cuid())
  weekId         String
  dayNumber      Int
  /// Month in the 28-day cycle (M in M1D28).
  cycleMonth     Int                 @default(1)
  /// Day within the month cycle (1–28).
  cycleDay       Int?
  workoutId      String?             // legacy / default option (first session primary)
  notes          String?
  videoUrl       String?
  calendarDate   String?             // YYYY-MM-DD
  defaultSets    Int?
  defaultReps    String?
  defaultRestSec Int?
  publishedAt    DateTime?
  /// How many sequential parts this day has (1 = normal; 2–3 = double/triple day).
  partCount      Int                 @default(1)
  /// Free Explorer sample day — coach-curated free pool (gamification content gate).
  freePool       Boolean             @default(false)
  /// Minimum ticket for this day: explorer | member | business | pro (null = inherit plan rules).
  contentTierMin String?
  week           ProgramWeek         @relation(fields: [weekId], references: [id], onDelete: Cascade)
  workout        Workout?            @relation(fields: [workoutId], references: [id])
  /// Sequential sessions on this calendar day (AM / midday cardio / PM, etc.).
  sessions       ProgramDaySession[]
  /// Denormalized: all options across sessions (prefer session.options).
  options        ProgramDayOption[]

  @@unique([weekId, dayNumber])
  @@index([freePool])
}

/// One ordered part of a program day (military double/triple days, etc.).
/// Gym vs Home tracks live on ProgramDayOption under this session — not as separate parts.
model ProgramDaySession {
  id          String             @id @default(cuid())
  dayId       String
  /// 1-based part index within the day (1, 2, 3…).
  partIndex   Int
  /// Coach-facing title: "AM Strength", "Fasted Cardio", "PM Conditioning".
  label       String
  /// strength | cardio | mobility | recovery | custom — not limited to weight training.
  sessionKind String             @default("strength")
  /// Optional time-of-day hint: morning | midday | afternoon | evening | free text.
  timeSlot    String?
  notes       String?            @db.Text
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  day         ProgramDay         @relation(fields: [dayId], references: [id], onDelete: Cascade)
  options     ProgramDayOption[]

  @@unique([dayId, partIndex])
  @@index([dayId, sortOrder])
  @@index([sessionKind])
}

model ProgramDayOption {
  id               String             @id @default(cuid())
  dayId            String
  /// Parent session/part (required for multi-part days; backfilled for legacy rows).
  sessionId        String?
  workoutId        String
  label            String // e.g. "Gym", "Home - Bodyweight", "Home - Dumbbells + Bands"
  /// Typed location — separate from workout name and label.
  trainingLocation String? // gym | home
  /// Per-session coach note for this track — does not travel with the workout template.
  notes            String?            @db.Text
  sortOrder        Int                @default(0)
  day              ProgramDay         @relation(fields: [dayId], references: [id], onDelete: Cascade)
  session          ProgramDaySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workout          Workout            @relation(fields: [workoutId], references: [id])

  @@index([sessionId])
  @@index([dayId, sessionId])
}

model ProgramEnrollment {
  id               String   @id @default(cuid())
  userId           String
  programId        String
  startedAt        DateTime @default(now())
  /// Member-chosen calendar day 1 of their paid 28-day block (today … today+6).
  programStartDate DateTime? @db.Date
  /// Last inclusive calendar day of the 28-day block.
  blockEndsAt      DateTime? @db.Date
  currentWeek      Int      @default(1)
  currentDay       Int      @default(1)
  /// Macro phase index (1=conditioning … 4=power for Adult).
  currentPhase     Int      @default(1)
  /// Member's Gym vs Home track — simple dropdown, not a wide options table.
  trainingLocation String   @default("gym")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program          Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  promptResponses  PromptResponse[]
}

model LiveSession {
  id          String   @id @default(cuid())
  title       String
  startsAt    DateTime
  durationMin Int      @default(60)
  meetingUrl  String?
  tierSlug    String   @default("first_class")
  createdAt   DateTime @default(now())
}

model AdminContact {
  id          String   @id @default(cuid())
  email       String
  phone       String?
  calendlyUrl String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model AdminAvailability {
  id              String   @id @default(cuid())
  weekday         Int      // 0=Sunday ... 6=Saturday
  startHour       Int      // 0-23
  startMinute     Int      // 0-59
  endHour         Int
  endMinute       Int
  slotDurationMin Int      @default(15)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  memberEmail   String
  memberPhone   String?
  adminEmail    String
  adminPhone    String?
  scheduledAt   DateTime
  durationMin   Int      @default(15)
  zoomUrl       String?
  zoomHostUrl   String?
  zoomMeetingId String?
  status        String   @default("pending") // pending, confirmed, completed, cancelled
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
}

/**
 * Durable SMS / messaging ledger (M&A / compliance).
 * Prefer this over demo JSON whenever Postgres is configured.
 * Append delivery lifecycle via SmsDeliveryEvent; never delete for audit retention.
 */
model SmsLog {
  id             String    @id @default(cuid())
  userId         String?
  phone          String
  message        String    @db.Text
  /** outbound | inbound */
  direction      String    @default("outbound")
  /** welcome | coach-reply | coach-chat-alert | broadcast | reminder | member-reply | hub | booking | ... */
  source         String    @default("unknown")
  /** sms | email_hub | simulated */
  channel        String    @default("sms")
  /**
   * queued | sent | delivered | failed | undelivered | received |
   * blocked_opt_out | skipped_paused | skipped_no_phone | skipped_invalid_phone
   */
  status         String    @default("sent")
  provider       String? // twilio | resend | none
  providerSid    String?
  providerStatus String?
  errorCode      String?
  errorMessage   String?   @db.Text
  category       String?
  simulated      Boolean   @default(false)
  /** Free-form structured context (taskDetails, coachId, sessionDate, etc.). */
  metadata       Json?
  sentAt         DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deliveredAt    DateTime?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  events         SmsDeliveryEvent[]

  @@index([userId, sentAt])
  @@index([providerSid])
  @@index([status, sentAt])
  @@index([direction, sentAt])
  @@index([source, sentAt])
  @@index([phone, sentAt])
}

/** Append-only status trail for a single SmsLog row (Twilio callbacks, gate blocks, etc.). */
model SmsDeliveryEvent {
  id         String   @id @default(cuid())
  smsLogId   String
  eventType  String // created | provider_accepted | status_callback | blocked | failed | note
  status     String?
  detail     String?  @db.Text
  rawPayload Json?
  createdAt  DateTime @default(now())
  smsLog     SmsLog   @relation(fields: [smsLogId], references: [id], onDelete: Cascade)

  @@index([smsLogId, createdAt])
  @@index([createdAt])
}

/**
 * Append-only system audit log for diligence / SOC2-minded M&A readiness.
 * Write on security-sensitive and compliance-sensitive actions (SMS, auth admin, billing later).
 */
model AuditEvent {
  id          String   @id @default(cuid())
  occurredAt  DateTime @default(now())
  actorUserId String?
  actorEmail  String?
  actorRole   String?
  /** e.g. sms.send | sms.inbound | sms.opt_out | sms.opt_in | messaging.pause */
  action      String
  entityType  String?
  entityId    String?
  /** success | failure | denied | info */
  outcome     String   @default("info")
  ip          String?
  userAgent   String?  @db.Text
  metadata    Json?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([action, occurredAt])
  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@index([outcome, occurredAt])
}

/** Coach-assigned daily workouts (SMS / lesson plan). workoutId may reference catalog or SMS blob workouts. */
model CoachTodaySession {
  id               String   @id
  sessionDate      String
  scheduledAt      DateTime
  title            String
  rawSms           String   @db.Text
  workoutId        String
  programSlug      String   @default("adult")
  userIds          String[]
  replacesSchedule Boolean  @default(true)
  createdAt        DateTime @default(now())
  createdBy        String?

  @@index([sessionDate])
  @@index([scheduledAt])
}

/**
 * Per-coach Zoom OAuth connection.
 * `id` = lower-case Train Station coach login email (was singleton "coach").
 */
model CoachZoomOAuth {
  id               String   @id
  zoomUserId       String
  email            String
  displayName      String
  refreshToken     String   @db.Text
  connectedAt      DateTime
  connectedByEmail String
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([connectedByEmail])
}

/** Short-lived Zoom OAuth state backup when the state cookie is missing. */
model ZoomOAuthPendingState {
  state      String   @id
  coachEmail String
  createdAt  DateTime @default(now())

  @@index([coachEmail])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Blob migration — Tier 1 (auth, profiles, SMS, OAuth, password reset)
// Tables unused at runtime until store facades flip migration flags (PR-2+).
// ---------------------------------------------------------------------------

model MemberProfile {
  userId                      String    @id
  email                       String
  plan                        String
  weightLbs                   String?
  notes                       String?   @db.Text
  onboardingComplete          Boolean   @default(false)
  completedAt                 DateTime?
  approvalStatus              String    @default("approved")
  approvedAt                  DateTime?
  paymentStatus               String    @default("none")
  paidAt                      DateTime?
  paymentMethod               String?
  paymentNote                 String?   @db.Text
  stripeCustomerId            String?
  stripeSubscriptionId        String?
  stripeCheckoutSessionId     String?
  referralCode                String?
  referredByUserId            String?
  intensiveSessionsTotal      Int?
  intensiveSessionsRemaining  Int?
  intensiveWindowDays         Int?
  intensiveStartsAt           DateTime?
  intensiveExpiresAt          DateTime?
  customTrainingOfferId       String?
  welcomeSignupEmailSentAt    DateTime?
  welcomeCompleteEmailSentAt  DateTime?
  welcomeSmsSentAt            DateTime?
  coachIntakeCompleteAt       DateTime?
  coachIntakeCompletedBy      String?
  introBookedAt               DateTime?
  coachMeetingRequestedAt     DateTime?
  coachMeetingRequestedBy     String?
  coachMeetingRequestNote     String?   @db.Text
  rampStartedAt               DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([paymentStatus])
  @@index([stripeCustomerId])
}

model OAuthIdentity {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  userId         String
  email          String
  linkedAt       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([email])
}

model PasswordResetToken {
  tokenHash String   @id
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Blob migration — Tier 2 (chat, live sessions, coach settings, prefs)
// ---------------------------------------------------------------------------

model CoachChatThread {
  id          String   @id
  kind        String
  memberId    String?
  programSlug String?
  title       String
  createdAt   DateTime
  updatedAt   DateTime

  messages CoachChatMessage[]

  @@index([memberId])
  @@index([programSlug])
  @@index([updatedAt])
}

model CoachChatMessage {
  id               String   @id
  threadId         String
  authorRole       String
  authorId         String
  authorName       String
  kind             String
  body             String?  @db.Text
  mediaUrl         String?
  youtubeId        String?
  videoDurationSec Int?
  sessionDate      String?
  todaySessionId   String?
  workoutId        String?
  workoutTitle     String?
  smsLogId         String?
  alertSent        Boolean  @default(false)
  readByUserIds    String[]
  reactions        Json?
  createdAt        DateTime

  thread CoachChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([authorId])
}

/** Browser/PWA Web Push endpoint for home-screen badge + phone alerts. */
model WebPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LiveWorkoutSession {
  id                String   @id @default(cuid())
  userId            String
  workoutId         String
  sessionDate       String
  completedSets     Json
  finishedExercises String[]
  weights           Json
  activeId          String?
  /// Coach floor rest controls mirrored to member mid-session.
  restTimerEnabled  Boolean?
  restTimerSeconds  Int?
  restTimerSound    String?
  /// Active rest popup { blockId, completedSetNum, endsAt, totalSeconds, startedBy }
  restActive        Json?
  updatedBy         String
  revision          Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([userId, workoutId, sessionDate])
  @@index([userId, sessionDate])
}

/// Shared class Zoom room for a business day — durable host/join state for instant member Join.
model LiveClassZoomDay {
  sessionDate String   @id
  /// Full LiveClassZoomRecord JSON
  record      Json
  updatedAt   DateTime @updatedAt
}

model CoachSettings {
  id                        String   @id @default("default")
  coachPhone                String?
  coachEmail                String?
  messagingEnabled          Boolean  @default(true)
  autoPromptIntroBooking    Boolean  @default(false)
  autoPromptFollowUpBooking Boolean  @default(false)
  commissionPayoutMode      String   @default("on_demand")
  commissionPayoutWeekday   Int      @default(5)
  alertPrefs                Json
  warmupBlocks              Json
  rampTemplate              Json
  gamificationPoints        Json
  /// How far ahead (days) a new member may schedule program Day 1 after payment.
  programStartMaxOffsetDays Int      @default(6)
  /// Weekday to recommend/default (0=Sun … 6=Sat). Null = no weekday preference.
  programStartRecommendWeekday Int?
  /// Length of paid program block in calendar days (default 28).
  programBlockDays          Int      @default(28)
  updatedAt                 DateTime @updatedAt
}

model MemberCoachPrefs {
  userId         String   @id
  coachingMode   String?
  alertOverrides Json
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Blob migration — Tier 3 (commerce, referrals, webhooks, waitlist, offers)
// ---------------------------------------------------------------------------

model CommissionPartner {
  id              String   @id
  name            String
  email           String
  stripeAccountId String?
  sharePercent    Float
  enabled         Boolean  @default(true)
  notes           String?  @db.Text
  createdAt       DateTime
  updatedAt       DateTime

  payoutLines CommissionPayoutLine[]

  @@index([email])
  @@index([enabled])
}

model CommissionPayout {
  id                   String   @id
  period               String   @unique
  mrrCents             Int
  tier1BaseCents       Int
  tier1CommissionCents Int
  tier2BaseCents       Int
  tier2CommissionCents Int
  totalCommissionCents Int
  transferId           String?
  status               String
  error                String?  @db.Text
  createdAt            DateTime
  paidAt               DateTime?

  partnerLines CommissionPayoutLine[]

  @@index([status])
}

model CommissionPayoutLine {
  id           String   @id @default(cuid())
  payoutId     String
  partnerId    String
  partnerName  String
  sharePercent Float
  amountCents  Int
  transferId   String?
  status       String
  error        String?  @db.Text

  payout  CommissionPayout  @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  partner CommissionPartner @relation(fields: [partnerId], references: [id])

  @@index([payoutId])
  @@index([partnerId])
}

model ReferralCode {
  id                    String   @id
  code                  String   @unique
  label                 String
  stripePromotionCodeId String?
  stripeCouponId        String?
  ownerUserId           String?
  enabled               Boolean  @default(true)
  notes                 String?  @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([ownerUserId])
}

model StripeWebhookEvent {
  eventId     String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model WaitlistEntry {
  id        String   @id
  email     String   @unique
  name      String
  firstName String?
  lastName  String?
  phone     String?
  plan      String?
  source    String?
  createdAt DateTime

  @@index([createdAt])
  @@index([plan])
}

model CustomTrainingOffer {
  id                      String   @id
  label                   String
  memberEmail             String?
  memberUserId            String?
  priceCents              Int
  currency                String   @default("usd")
  parameters              Json
  status                  String
  stripeCheckoutSessionId String?
  createdByEmail          String?
  notes                   String?  @db.Text
  createdAt               DateTime
  updatedAt               DateTime

  @@index([memberUserId])
  @@index([memberEmail])
  @@index([status])
}

/** Reference prescription patterns (seeded from workout-prescription-examples.csv). */
model PrescriptionExample {
  id                 Int      @id
  patternType        String
  sampleExercise     String
  setCount           Int
  restBetweenSetsSec Int      @default(90)
  weightTier         String   @default("medium")
  phase1Type         String?
  phase1DurationSec  Int?
  phase1Reps         Int?
  phase1RepKind      String?
  phase1PositionCue  String?
  phase2Type         String?
  phase2DurationSec  Int?
  phase2Reps         Int?
  phase2RepKind      String?
  phase2PositionCue  String?
  notes              String?  @db.Text
  summary            String
  updatedAt          DateTime @updatedAt

  @@index([patternType])
}

model Equipment {
  id          String             @id @default(cuid())
  name        String             @unique
  category    String?            // e.g. "bodyweight", "dumbbells", "bands", "bench", "barbell", "pullup", "kettlebell"
  description String?
  /** Shop / Amazon (etc.) product page — members open in a new tab. */
  productUrl  String?
  /** Preview image pulled from the product link (og:image) or set by coach. */
  imageUrl    String?
  createdAt   DateTime           @default(now())
  exercises   ExerciseEquipment[]
  userItems   UserEquipment[]
}

model ExerciseEquipment {
  exerciseId  String
  equipmentId String
  exercise    Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment   Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  @@id([exerciseId, equipmentId])
}

model UserEquipment {
  id          String     @id @default(cuid())
  userId      String
  equipmentId String
  hasAtHome   Boolean    @default(true)
  quantity    Int        @default(1)
  notes       String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment   Equipment  @relation(fields: [equipmentId], references: [id])
  @@unique([userId, equipmentId])
}

model UserWeatherLog {
  id          String   @id @default(cuid())
  userId      String
  city        String?
  state       String?
  temperature Float?
  weatherCode Int?
  condition   String?
  windSpeed   Float?
  observedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, observedAt])
}

model EatingApproach {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  category    String?  // "eating"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  prompts     Prompt[]
}

model Prompt {
  id          String   @id @default(cuid())
  approachId  String
  dayNumber   Int
  text        String
  createdAt   DateTime @default(now())
  approach    EatingApproach @relation(fields: [approachId], references: [id])
  responses   PromptResponse[]
}

model PromptResponse {
  id            String   @id @default(cuid())
  userId        String
  promptId      String
  enrollmentId  String?
  answer        String?
  notes         String?
  completedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt        Prompt   @relation(fields: [promptId], references: [id])
  enrollment    ProgramEnrollment? @relation(fields: [enrollmentId], references: [id])
}

model UserMeasurement {
  id          String   @id @default(cuid())
  userId      String
  weightLbs   Float?
  notes       String?
  measuredAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
}

// ---------------------------------------------------------------------------
// Data warehouse — behavioral events, payment facts, daily marts
// ---------------------------------------------------------------------------

model AnalyticsSession {
  id               String           @id @default(cuid())
  sessionKey       String           @unique
  userId           String?
  anonymousId      String?
  startedAt        DateTime         @default(now())
  lastActivityAt   DateTime         @default(now())
  landingPath      String?
  referrer         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  deviceType       String?
  userAgent        String?
  convertedSignup  Boolean          @default(false)
  convertedPaid    Boolean          @default(false)
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  events           AnalyticsEvent[]

  @@index([userId])
  @@index([startedAt])
  @@index([lastActivityAt])
}

model AnalyticsEvent {
  id            String            @id @default(cuid())
  sessionKey    String?
  sessionId     String?
  eventType     String
  occurredAt    DateTime          @default(now())
  userId        String?
  anonymousId   String?
  pagePath      String?
  pageTitle     String?
  pageSection   String?
  referrer      String?
  elementId     String?
  elementText   String?
  elementRole   String?
  clickHref     String?
  clickAction   String?
  programId     String?
  programSlug   String?
  workoutId     String?
  exerciseId    String?
  enrollmentId  String?
  tierSlug      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  deviceType    String?
  role          String?
  properties    Json?
  session       AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([userId, occurredAt])
  @@index([sessionKey, occurredAt])
  @@index([pagePath, occurredAt])
  @@index([occurredAt])
}

model FactSubscriptionPayment {
  id                    String   @id @default(cuid())
  userId                String?
  stripeInvoiceId       String?  @unique
  stripePaymentIntentId String?
  stripeSubscriptionId  String?
  stripeCustomerId      String?
  amountCents           Int
  amountRefundedCents   Int      @default(0)
  currency              String   @default("usd")
  status                String
  tierSlug              String?
  planId                String?
  billingReason         String?
  paidAt                DateTime
  periodStart           DateTime?
  periodEnd             DateTime?
  stripeEventId         String?
  properties            Json?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([paidAt])
  @@index([userId, paidAt])
  @@index([status, paidAt])
}

model FactCommissionPayout {
  id               String    @id @default(cuid())
  partnerId        String?
  partnerEmail     String?
  amountCents      Int
  currency         String    @default("usd")
  status           String
  stripeTransferId String?
  periodStart      DateTime?
  periodEnd        DateTime?
  paidAt           DateTime?
  properties       Json?
  createdAt        DateTime  @default(now())

  @@index([paidAt])
  @@index([partnerId])
  @@index([status])
}

model MartDailyMetrics {
  id                   String   @id @default(cuid())
  metricDate           DateTime @db.Date
  activeMembers        Int      @default(0)
  payingMembers        Int      @default(0)
  mrrCents             Int      @default(0)
  newSignups           Int      @default(0)
  workoutCompletions   Int      @default(0)
  pageViews            Int      @default(0)
  pageClicks           Int      @default(0)
  uniqueVisitors       Int      @default(0)
  liveSessionsJoined   Int      @default(0)
  churnedSubscriptions Int      @default(0)
  properties           Json?
  computedAt           DateTime @default(now())

  @@unique([metricDate])
}

model MartMemberDailySnapshot {
  id                   String   @id @default(cuid())
  userId               String
  snapshotDate         DateTime @db.Date
  tierSlug             String?
  role                 String
  isPaying             Boolean  @default(false)
  workoutsCompleted    Int      @default(0)
  exercisesLogged      Int      @default(0)
  gamificationPoints   Int      @default(0)
  programSlug          String?
  enrollmentDay        Int?
  daysSinceLastWorkout Int?
  city                 String?
  state                String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([snapshotDate])
  @@index([snapshotDate, isPaying])
}
// ---------------------------------------------------------------------------
// Gamification (v2) — ledger, seasons, promos, config levers
// ---------------------------------------------------------------------------

model GamificationConfig {
  id        String   @id @default("default")
  /// Levers JSON — freeContentPercent, topPercentile, freeWeekDays, etc.
  levers    Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model GamificationEvent {
  id          String   @id
  userId      String
  type        String
  points      Int
  label       String
  at          DateTime
  programSlug String?
  seasonKey   String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([userId, at])
  @@index([seasonKey, userId])
  @@index([type, at])
  @@index([userId, type])
}

model GamificationSeasonScore {
  userId      String
  seasonKey   String
  division    String
  points      Int      @default(0)
  activeDays  Int      @default(0)
  lastEventAt DateTime?
  rank        Int?
  percentile  Float?
  updatedAt   DateTime @updatedAt

  @@id([userId, seasonKey])
  @@index([seasonKey, division, points])
  @@index([seasonKey, division, rank])
}

model GamificationPromo {
  id          String    @id @default(cuid())
  userId      String
  kind        String    @default("free_week_upgrade")
  fromPlan    String
  toPlan      String
  status      String    @default("offered")
  offeredAt   DateTime  @default(now())
  claimBy     DateTime?
  claimedAt   DateTime?
  trialEndsAt DateTime?
  convertedAt DateTime?
  revokedAt   DateTime?
  notes       String?

  @@index([userId, status])
  @@index([status, claimBy])
  @@index([status, trialEndsAt])
}

model GamificationPrizeAward {
  id        String   @id @default(cuid())
  userId    String
  seasonKey String
  label     String
  freeDays  Int?
  notes     String?
  awardedAt DateTime @default(now())
  awardedBy String?

  @@index([userId, seasonKey])
  @@index([seasonKey])
}

/// Append-only audit trail for M&A / compliance (config, promos, ranks, claims).
model GamificationAuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  /// actor user id (staff or member)
  actorId    String
  actorRole  String?
  /// e.g. config.patch | promo.offer | promo.claim | promo.revoke | season.recompute
  action     String
  /// optional subject member / promo / config id
  targetId   String?
  /// free-form structured payload (before/after, amounts) — no secrets
  detail     Json?
  ip         String?
  userAgent  String?

  @@index([at])
  @@index([actorId, at])
  @@index([action, at])
  @@index([targetId, at])
}
