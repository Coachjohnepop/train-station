generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: With Prisma 7 + "prisma-client" generator, connection URLs live in
  // prisma.config.ts (for CLI/migrate) and are passed via driver adapter to
  // PrismaClient constructor (see src/lib/prisma.ts and prisma/seed.ts).
  // We still document DATABASE_URL / DIRECT_URL usage in .env.example.
}

enum Role {
  ADMIN
  INSTRUCTOR
  PLATFORM_ADMIN
  MEMBER
  PROSPECTIVE_INSTRUCTOR
}

/** What happens in one phase of a working set (hold, reps, burnout, timed). */
enum SetPhaseType {
  HOLD
  REPS
  BURNOUT
  TIMED
}

/** How rep count is prescribed when phaseType is REPS (or burnout logging). */
enum RepKind {
  FIXED
  BURNOUT
  MAX
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  phone              String?
  dailyReminderTime  String?             // e.g. "07:30" in 24h format
  city               String?
  state              String?
  heightCm           Int?
  birthdate          DateTime?
  goals              String?
  role               Role                @default(MEMBER)
  passwordHash       String?
  status             String              @default("active")
  hidden             Boolean             @default(false)
  hiddenAt           DateTime?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  subscriptions      Subscription[]
  enrollments        ProgramEnrollment[]
  performances       ExercisePerformance[]
  workoutLogs        WorkoutLog[]
  smsLogs            SmsLog[]
  bookings           Booking[]
  homeEquipment      UserEquipment[]
  weatherLogs        UserWeatherLog[]
  promptResponses    PromptResponse[]
  measurements       UserMeasurement[]
  analyticsSessions  AnalyticsSession[]
  analyticsEvents    AnalyticsEvent[]
  subscriptionPayments FactSubscriptionPayment[]
  memberDailySnapshots MartMemberDailySnapshot[]
}

model SubscriptionTier {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  stripePriceId String?
  monthlyCents  Int?
  subscriptions Subscription[]
}

model Subscription {
  id               String           @id @default(cuid())
  userId           String
  tierId           String
  stripeCustomerId String?
  stripeSubId      String?
  status           String           @default("active")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier             SubscriptionTier @relation(fields: [tierId], references: [id])
}

model Exercise {
  id                String                @id @default(cuid())
  name              String
  defaultSetScheme  String?
  defaultSets       Int?
  defaultWeightTier String?
  description       String?
  videoUrl          String?
  tags              String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workoutItems      WorkoutExercise[]
  performances      ExercisePerformance[]
  requiredEquipment ExerciseEquipment[]
}

model Workout {
  id          String            @id @default(cuid())
  name        String
  description String?
  certifiedAt DateTime?
  exportText  String?           @db.Text
  certifiedBy String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  exercises   WorkoutExercise[]
  programDays ProgramDay[]
  dayOptions  ProgramDayOption[]
  logs        WorkoutLog[]
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  exerciseId String
  sortOrder  Int      @default(0)
  setScheme  String?
  repPattern String?
  weightTier String?
  /// Legacy flat prescription — migrate to setCount + phases, then deprecate.
  sets       Int?
  reps       String?
  restSec    Int?
  /// Structured prescription: number of working sets (1–10).
  setCount             Int?
  /// Rest between working sets in seconds (e.g. 90 for 1:30).
  restBetweenSetsSec   Int?
  notes      String?
  workout    Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise  @relation(fields: [exerciseId], references: [id])
  phases     WorkoutSetPhase[]

  @@index([workoutId, sortOrder])
}

/// Template for what happens inside one working set; repeats for all setCount sets.
model WorkoutSetPhase {
  id                String        @id @default(cuid())
  workoutExerciseId String
  phaseIndex        Int
  phaseType         SetPhaseType
  durationSec       Int?
  reps              Int?
  repKind           RepKind       @default(FIXED)
  positionCue       String?
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, phaseIndex])
  @@index([workoutExerciseId])
}

model ExercisePerformance {
  id                String   @id @default(cuid())
  userId            String
  exerciseId        String
  workoutExerciseId String?
  setScheme         String
  weightTier        String
  startingWeightLbs Float?
  repsCompleted     Int?     // total reps completed at the logged weight in this session
  setsCompleted     Int?     // number of sets completed
  performedAt       DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise          Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId, performedAt])
}

model WorkoutLog {
  id          String   @id @default(cuid())
  userId      String
  workoutId   String
  performedAt DateTime @default(now())
  completed   Boolean  @default(true)
  progress    Int      @default(100)  // % of exercises marked finished when logged (0-100)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout     Workout  @relation(fields: [workoutId], references: [id])

  @@index([userId, performedAt])
}

model Program {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  description        String?
  tierSlug           String              @default("starter")
  category           String?
  durationWeeks      Int                 @default(4)
  phaseDurationWeeks Int                 @default(4)
  totalPhases        Int                 @default(1)
  sortOrder          Int                 @default(0)
  published          Boolean             @default(true)
  coverUrl           String?
  startDate          String?             // YYYY-MM-DD program calendar anchor
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  weeks              ProgramWeek[]
  enrollments        ProgramEnrollment[]
}

model ProgramWeek {
  id         String       @id @default(cuid())
  programId  String
  weekNumber Int
  program    Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  days       ProgramDay[]

  @@unique([programId, weekNumber])
}

model ProgramDay {
  id             String             @id @default(cuid())
  weekId         String
  dayNumber      Int
  workoutId      String?            // legacy / default option
  notes          String?
  videoUrl       String?
  calendarDate   String?            // YYYY-MM-DD
  defaultSets    Int?
  defaultReps    String?
  defaultRestSec Int?
  publishedAt    DateTime?
  week           ProgramWeek        @relation(fields: [weekId], references: [id], onDelete: Cascade)
  workout        Workout?           @relation(fields: [workoutId], references: [id])
  options        ProgramDayOption[]

  @@unique([weekId, dayNumber])
}

model ProgramDayOption {
  id        String     @id @default(cuid())
  dayId     String
  workoutId String
  label     String     // e.g. "Gym", "Home - Bodyweight", "Home - Dumbbells + Bands"
  sortOrder Int        @default(0)
  day       ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  workout   Workout    @relation(fields: [workoutId], references: [id])
}

model ProgramEnrollment {
  id          String   @id @default(cuid())
  userId      String
  programId   String
  startedAt   DateTime @default(now())
  currentWeek Int      @default(1)
  currentDay  Int      @default(1)
  currentPhase Int     @default(1)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  promptResponses PromptResponse[]
}

model LiveSession {
  id          String   @id @default(cuid())
  title       String
  startsAt    DateTime
  durationMin Int      @default(60)
  meetingUrl  String?
  tierSlug    String   @default("first_class")
  createdAt   DateTime @default(now())
}

model AdminContact {
  id          String   @id @default(cuid())
  email       String
  phone       String?
  calendlyUrl String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model AdminAvailability {
  id              String   @id @default(cuid())
  weekday         Int      // 0=Sunday ... 6=Saturday
  startHour       Int      // 0-23
  startMinute     Int      // 0-59
  endHour         Int
  endMinute       Int
  slotDurationMin Int      @default(15)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  memberEmail   String
  memberPhone   String?
  adminEmail    String
  adminPhone    String?
  scheduledAt   DateTime
  durationMin   Int      @default(15)
  zoomUrl       String?
  zoomHostUrl   String?
  zoomMeetingId String?
  status        String   @default("pending") // pending, confirmed, completed, cancelled
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
}

model SmsLog {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  message   String
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

/** Coach-assigned daily workouts (SMS / lesson plan). workoutId may reference catalog or SMS blob workouts. */
model CoachTodaySession {
  id               String   @id
  sessionDate      String
  scheduledAt      DateTime
  title            String
  rawSms           String   @db.Text
  workoutId        String
  programSlug      String   @default("adult")
  userIds          String[]
  replacesSchedule Boolean  @default(true)
  createdAt        DateTime @default(now())
  createdBy        String?

  @@index([sessionDate])
  @@index([scheduledAt])
}

/** Coach Zoom OAuth connection (singleton row, id = "coach"). */
model CoachZoomOAuth {
  id               String   @id
  zoomUserId       String
  email            String
  displayName      String
  refreshToken     String   @db.Text
  connectedAt      DateTime
  connectedByEmail String
  updatedAt        DateTime @updatedAt
}

/** Short-lived Zoom OAuth state backup when the state cookie is missing. */
model ZoomOAuthPendingState {
  state      String   @id
  coachEmail String
  createdAt  DateTime @default(now())

  @@index([coachEmail])
  @@index([createdAt])
}

/** Reference prescription patterns (seeded from workout-prescription-examples.csv). */
model PrescriptionExample {
  id                 Int      @id
  patternType        String
  sampleExercise     String
  setCount           Int
  restBetweenSetsSec Int      @default(90)
  weightTier         String   @default("medium")
  phase1Type         String?
  phase1DurationSec  Int?
  phase1Reps         Int?
  phase1RepKind      String?
  phase1PositionCue  String?
  phase2Type         String?
  phase2DurationSec  Int?
  phase2Reps         Int?
  phase2RepKind      String?
  phase2PositionCue  String?
  notes              String?  @db.Text
  summary            String
  updatedAt          DateTime @updatedAt

  @@index([patternType])
}

model Equipment {
  id          String             @id @default(cuid())
  name        String             @unique
  category    String?            // e.g. "bodyweight", "dumbbells", "bands", "bench", "barbell", "pullup", "kettlebell"
  description String?
  createdAt   DateTime           @default(now())
  exercises   ExerciseEquipment[]
  userItems   UserEquipment[]
}

model ExerciseEquipment {
  exerciseId  String
  equipmentId String
  exercise    Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment   Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  @@id([exerciseId, equipmentId])
}

model UserEquipment {
  id          String     @id @default(cuid())
  userId      String
  equipmentId String
  hasAtHome   Boolean    @default(true)
  quantity    Int        @default(1)
  notes       String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment   Equipment  @relation(fields: [equipmentId], references: [id])
  @@unique([userId, equipmentId])
}

model UserWeatherLog {
  id          String   @id @default(cuid())
  userId      String
  city        String?
  state       String?
  temperature Float?
  weatherCode Int?
  condition   String?
  windSpeed   Float?
  observedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, observedAt])
}

model EatingApproach {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  category    String?  // "eating"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  prompts     Prompt[]
}

model Prompt {
  id          String   @id @default(cuid())
  approachId  String
  dayNumber   Int
  text        String
  createdAt   DateTime @default(now())
  approach    EatingApproach @relation(fields: [approachId], references: [id])
  responses   PromptResponse[]
}

model PromptResponse {
  id            String   @id @default(cuid())
  userId        String
  promptId      String
  enrollmentId  String?
  answer        String?
  notes         String?
  completedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt        Prompt   @relation(fields: [promptId], references: [id])
  enrollment    ProgramEnrollment? @relation(fields: [enrollmentId], references: [id])
}

model UserMeasurement {
  id          String   @id @default(cuid())
  userId      String
  weightLbs   Float?
  notes       String?
  measuredAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
}

// ---------------------------------------------------------------------------
// Data warehouse — behavioral events, payment facts, daily marts
// ---------------------------------------------------------------------------

model AnalyticsSession {
  id               String           @id @default(cuid())
  sessionKey       String           @unique
  userId           String?
  anonymousId      String?
  startedAt        DateTime         @default(now())
  lastActivityAt   DateTime         @default(now())
  landingPath      String?
  referrer         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  deviceType       String?
  userAgent        String?
  convertedSignup  Boolean          @default(false)
  convertedPaid    Boolean          @default(false)
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  events           AnalyticsEvent[]

  @@index([userId])
  @@index([startedAt])
  @@index([lastActivityAt])
}

model AnalyticsEvent {
  id            String            @id @default(cuid())
  sessionKey    String?
  sessionId     String?
  eventType     String
  occurredAt    DateTime          @default(now())
  userId        String?
  anonymousId   String?
  pagePath      String?
  pageTitle     String?
  pageSection   String?
  referrer      String?
  elementId     String?
  elementText   String?
  elementRole   String?
  clickHref     String?
  clickAction   String?
  programId     String?
  programSlug   String?
  workoutId     String?
  exerciseId    String?
  enrollmentId  String?
  tierSlug      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  deviceType    String?
  role          String?
  properties    Json?
  session       AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([userId, occurredAt])
  @@index([sessionKey, occurredAt])
  @@index([pagePath, occurredAt])
  @@index([occurredAt])
}

model FactSubscriptionPayment {
  id                    String   @id @default(cuid())
  userId                String?
  stripeInvoiceId       String?  @unique
  stripePaymentIntentId String?
  stripeSubscriptionId  String?
  stripeCustomerId      String?
  amountCents           Int
  amountRefundedCents   Int      @default(0)
  currency              String   @default("usd")
  status                String
  tierSlug              String?
  planId                String?
  billingReason         String?
  paidAt                DateTime
  periodStart           DateTime?
  periodEnd             DateTime?
  stripeEventId         String?
  properties            Json?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([paidAt])
  @@index([userId, paidAt])
  @@index([status, paidAt])
}

model FactCommissionPayout {
  id               String    @id @default(cuid())
  partnerId        String?
  partnerEmail     String?
  amountCents      Int
  currency         String    @default("usd")
  status           String
  stripeTransferId String?
  periodStart      DateTime?
  periodEnd        DateTime?
  paidAt           DateTime?
  properties       Json?
  createdAt        DateTime  @default(now())

  @@index([paidAt])
  @@index([partnerId])
  @@index([status])
}

model MartDailyMetrics {
  id                   String   @id @default(cuid())
  metricDate           DateTime @db.Date
  activeMembers        Int      @default(0)
  payingMembers        Int      @default(0)
  mrrCents             Int      @default(0)
  newSignups           Int      @default(0)
  workoutCompletions   Int      @default(0)
  pageViews            Int      @default(0)
  pageClicks           Int      @default(0)
  uniqueVisitors       Int      @default(0)
  liveSessionsJoined   Int      @default(0)
  churnedSubscriptions Int      @default(0)
  properties           Json?
  computedAt           DateTime @default(now())

  @@unique([metricDate])
}

model MartMemberDailySnapshot {
  id                   String   @id @default(cuid())
  userId               String
  snapshotDate         DateTime @db.Date
  tierSlug             String?
  role                 String
  isPaying             Boolean  @default(false)
  workoutsCompleted    Int      @default(0)
  exercisesLogged      Int      @default(0)
  gamificationPoints   Int      @default(0)
  programSlug          String?
  enrollmentDay        Int?
  daysSinceLastWorkout Int?
  city                 String?
  state                String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([snapshotDate])
  @@index([snapshotDate, isPaying])
}