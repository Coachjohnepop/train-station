{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "allaboard.fit" }],
      "destination": "https://www.thetrainstation.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "allaboard.fit" }],
      "destination": "https://www.thetrainstation.co/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.allaboard.fit" }],
      "destination": "https://www.thetrainstation.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.allaboard.fit" }],
      "destination": "https://www.thetrainstation.co/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/mart-rollup",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/gamification-season",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/cron/staff-grants",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/rebuild-free-ticket-full",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/postgres-backup",
      "schedule": "0 16 * * 0"
    }
  ]
}